# MediCare Clinical Suite - Production Environment Configuration
# Copy this file or set environment variables in your hosting provider

# Application Port
PORT=3000

# Node Environment
NODE_ENV=production

# Server Cryptographic Secret (Used for HMAC Session Tokens & CSRF)
# Generate a strong 64+ char random string in production
MEDICARE_SECRET=medicare_prod_clinical_secret_9823fbd02a83e01bc49a37e192

# SQLite Database File Path
DB_FILE=medicare.sqlite

# Security & Rate Limiting Settings
# Rate limit for authentication attempts (per 15 minutes window)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# Default Admin Setup (Used ONLY on first bootstrap if no admin exists)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=Admin@MediCare2026!

# Set to true to enforce HTTPS Strict-Transport-Security in production reverse proxy
ENFORCE_HSTS=false
